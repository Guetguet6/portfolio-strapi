{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": ""
  },
  "options": {
    "draftAndPublish": true,
    "privateAttributes": ["createdAt", "updatedAt", "publishedAt"]
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "startDate": {
      "type": "date"
    },
    "endDate": {
      "type": "date"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "githubUrl": {
      "type": "string",
      "required": true
    },
    "liveUrl": {
      "type": "string"
    },
    "description": {
      "type": "richtext"
    },
    "improvement": {
      "type": "richtext"
    },
    "projectStatus": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Terminé",
        "En cours"
      ]
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "Personnel",
        "Professionnel",
        "Scolaire"
      ]
    },
    "contributors": {
      "type": "component",
      "component": "shared.contributors",
      "repeatable": true
    },
    "comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comment.comment",
      "mappedBy": "project"
    }
  }
}
